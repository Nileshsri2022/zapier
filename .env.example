# ==============================================
# Root Environment Variables (Example)
# ==============================================

# Google OAuth (Gmail, Sheets, Calendar)
# NOTE: the code reads GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET. This example
# previously said GMAIL_CLIENT_*, which no code reads.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gmail PubSub (requires https endpoint - use ngrok for local)
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications
# Required: without it, Gmail push notifications are rejected (fail closed).
GMAIL_WEBHOOK_SECRET=your-webhook-secret
# Gmail triggers execute in apps/worker via the ZapRunOutbox (see reports/gmail-worker-routing-spec.md).

# Inbound webhook signatures (optional)
# When set, every POST to /api/triggers/webhook/:zapId must carry a valid
# x-webhook-signature. When unset, unsigned webhooks are accepted and the
# unguessable zapId is the capability token.
# WEBHOOK_SECRET=your-webhook-secret

# Cron authentication (required for the scheduled endpoints)
# Shared by server (/api/cron/*), processor and worker. Unset means those
# endpoints reject all requests.
CRON_SECRET=your-random-cron-secret

# WhatsApp Cloud API ingress (apps/hooks). Both are required; every unset case
# fails closed rather than trusting the request.
# - WHATSAPP_APP_SECRET signs every delivery (X-Hub-Signature-256). Unset means
#   every POST is rejected with 401.
# - WHATSAPP_VERIFY_TOKEN answers Meta's GET verification handshake. Unset means
#   every GET is rejected with 403. There is no built-in fallback: a token
#   committed to this repository would let anyone verify and take over the
#   registration of an app that never configured one.
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=your-random-verify-token

# Kafka Configuration
KAFKA_BROKER=your-kafka-broker.aivencloud.com:14925
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your-kafka-password

# CORS: extra exact origins allowed to call the API (comma-separated; no wildcards).
# Built in: zapier-web-seven.vercel.app, the zapier project's deployment/branch
# URLs under nilesh-srivastavas-projects.vercel.app, and localhost:3000.
# FRONTEND_URL below is also honored. Never allow all *.vercel.app with cookies.
# CORS_ORIGIN=https://staging.example.com,https://app.example.com

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# AI connection foundation (optional; leave unset to disable compatible connections).
# Keys: JSON object of key IDs -> canonical base64-encoded 32-byte secrets.
# Configure in deployment secret manager; never commit real credentials.
# AI_CONNECTION_ENCRYPTION_KEYS=
# AI_CONNECTION_ACTIVE_KEY_ID=
# Exact approved public DNS names, comma-separated; empty denies compatible endpoints.
# AI_COMPATIBLE_ALLOWED_HOSTS=
# See reports/ai-connection-operations.md for migration, key rotation and safety gates.

# AI Transform (worker execution + server discovery, preview and connection probes).
# Optional default provider; only configured providers are selected.
# AI_DEFAULT_PROVIDER=openai
# Platform providers need BOTH a selected/default model and a provider-specific allowlist.
# Choose currently supported, reviewed model IDs; no unverified built-in model IDs are used.
# OPENAI_API_KEY=
# AI_DEFAULT_MODEL_OPENAI=
# AI_MODEL_ALLOWLIST_OPENAI=
# ANTHROPIC_API_KEY=
# AI_DEFAULT_MODEL_ANTHROPIC=
# AI_MODEL_ALLOWLIST_ANTHROPIC=
# Puter is experimental/gated; SDK 2.6.4 requires Node.js 22+ in this adapter.
# PUTER_AUTH_TOKEN=
# AI_DEFAULT_MODEL_PUTER=
# AI_MODEL_ALLOWLIST_PUTER=
# AI_PUTER_ENABLED=false
# Hard ceilings: values may be reduced, not increased beyond these maxima.
# AI_MAX_INPUT_CHARS=20000
# AI_MAX_OUTPUT_TOKENS=2000
# AI_TIMEOUT_MS=60000
# AI_MAX_RESPONSE_BYTES=1048576
# Every attempt/repair reserves quota; Redis outage fails AI only by default.
# AI_DAILY_CALL_CAP_PER_USER=200
# AI_DAILY_CALL_CAP_GLOBAL=0
# AI_BUDGET_FAIL_OPEN=false
# Worker budget service uses the same Upstash settings as server; provide real secrets in deployment.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
