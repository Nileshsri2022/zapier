# ==============================================
# Server Environment Variables
# ==============================================

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Secret for authentication
JWT_SECRET=your-random-jwt-secret

# Server Port
PORT=5000

# Email (Resend - https://resend.com) - used for signup/welcome and failure alerts
RESEND_API_KEY=re_your_api_key
SENDER_EMAIL=onboarding@resend.dev

# (No SMTP settings: Zap "Email" actions are sent by apps/worker via
# Resend. The server-inline nodemailer executor was removed in
# gmail-worker-routing-spec P5 — SMTP_* variables are ignored.)

# Google OAuth (for Gmail and Google Sheets integrations)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/sheets/auth/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/auth/callback
FRONTEND_URL=http://localhost:3000

# Extra exact CORS origins (comma-separated; no wildcards).
# The production aliases and zapier deployment/branch URLs in the
# nilesh-srivastavas-projects Vercel team are built in. FRONTEND_URL is also allowed.
# CORS_ORIGIN=https://staging.example.com,https://app.example.com

# Upstash Redis (for Google Sheets row hashing state)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cron authentication - required for /api/cron/* (called by cron-job.org)
CRON_SECRET=your-random-cron-secret

# Inbound webhook signatures (optional; see root .env.example)
# WEBHOOK_SECRET=your-webhook-secret

# Gmail push notifications - required, notifications are rejected without it
GMAIL_WEBHOOK_SECRET=your-webhook-secret

# Gmail triggers execute in apps/worker via the ZapRunOutbox (single
# engine since gmail-worker-routing-spec P5 — no routing switch).

# Gmail Pub/Sub push authentication (OIDC). Set both in production:
# the audience on the push subscription's OIDC token (usually your webhook
# URL) and the Google service account allowed to publish to your endpoint.
# GMAIL_PUBSUB_AUDIENCE=https://your-server.onrender.com/api/gmail/webhook
# GMAIL_PUBSUB_SERVICE_ACCOUNT=gmail-push@your-project.iam.gserviceaccount.com
