# Production Environment Variables Template
# Copy this file and fill in the values

# Required - Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# Required - Authentication
JWT_SECRET="your-jwt-secret-at-least-32-characters-long"

# Server Configuration
PORT=10000
NODE_ENV=production

# Frontend for OAuth redirects and CORS (use a stable URL, not a deployment hash)
FRONTEND_URL=https://zapier-web-seven.vercel.app
# Additional trusted origins only; comma-separated, no wildcards.
# Project aliases and zapier deployment/branch URLs in the
# nilesh-srivastavas-projects Vercel team are already allowed.
# CORS_ORIGIN=https://staging.example.com

# Optional - Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional - Webhook Security
WEBHOOK_SECRET=your-webhook-secret
